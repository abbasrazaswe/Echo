# Copy to .env locally. Never commit real credentials.
# Chat sends the question, bounded recent turns and selected evidence to OpenAI.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Choose an available model supporting Responses API Structured Outputs.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=1600

# Embeddings remain local (all-MiniLM-L6-v2).
# SQLite/model/vector paths are fixed under backend/data/profiles/ for now.
